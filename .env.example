# ── 서버 전용 (절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요) ──
SUPABASE_URL=https://mxqmtcnenxkzvfitajwc.supabase.co
# Supabase 대시보드 > Project Settings > API Keys > Secret keys (sb_secret_...)
SUPABASE_SECRET_KEY=
# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=
# 토스페이먼츠 개발자센터 > API 키 > 결제창형(주문서형) 연동 키 > 시크릿 키 (test_gsk_... / live_gsk_...)
TOSS_SECRET_KEY=
# 달러(USD) 결제용 MID의 시크릿 키. 달러 결제를 받을 때만 넣습니다.
TOSS_SECRET_KEY_USD=
# PG 심사 전 테스트용: true면 토스페이먼츠 클라이언트 키가 없을 때 결제 없이 풀이가 열립니다. 정식 오픈 전 반드시 지우세요.
ALLOW_MOCK_PAYMENT=false

# ── 브라우저 공개 값 ──
# 토스페이먼츠 결제창형(주문서형) 연동 키 > 클라이언트 키 (test_gck_... / live_gck_...)
NEXT_PUBLIC_TOSS_CLIENT_KEY=
# 달러(USD) 결제용 MID의 클라이언트 키. 넣으면 영문 페이지 결제를 달러로 받는다(비우면 원화).
NEXT_PUBLIC_TOSS_CLIENT_KEY_USD=
# 달러 MID 결제 어드민에서 외화결제를 설정한 결제 UI의 variantKey (비우면 기본 UI)
NEXT_PUBLIC_TOSS_VARIANT_KEY_USD=
NEXT_PUBLIC_SITE_NAME=운명다방
# 해외(영문, /en) 페이지에 쓰는 상호
NEXT_PUBLIC_SITE_NAME_EN=Unmyeong Dabang
# 공유 링크 미리보기 이미지에 쓰는 사이트 주소. 비우면 Vercel 운영 도메인을 씁니다.
NEXT_PUBLIC_SITE_URL=

# 사이트 하단·약관에 표시되는 사업자 정보 (비워 두면 '등록 예정')
