# ── 서버 전용 (절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요) ──
SUPABASE_URL=https://mxqmtcnenxkzvfitajwc.supabase.co
# Supabase 대시보드 > Project Settings > API Keys > Secret keys (sb_secret_...)
SUPABASE_SECRET_KEY=
# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=
# 포트원 관리자 콘솔 > 결제 연동 > 연동 정보 > V2 API Secret
PORTONE_API_SECRET=
# 포트원 관리자 콘솔 > 결제 연동 > 웹훅 > 웹훅 시크릿
PORTONE_WEBHOOK_SECRET=
# 매일 운세 알림톡 발송용 Vercel Cron 인증 (아무 긴 무작위 문자열)
CRON_SECRET=
# 솔라피(solapi.com): 인증번호 문자 + 카카오 알림톡. 비워 두면 구독 기능이 "준비 중"으로 표시됩니다.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 솔라피에 등록한 발신번호 (예: 01012345678)
SOLAPI_SENDER=
# 솔라피에 연동한 카카오 채널의 pfId, 검수 완료된 매일 운세 템플릿 ID
KAKAO_PFID=
KAKAO_DAILY_TEMPLATE_ID=
# PG 심사 전 테스트용: true면 포트원 키가 없을 때 결제 없이 풀이가 열립니다. 정식 오픈 전 반드시 지우세요.
ALLOW_MOCK_PAYMENT=false

# ── 브라우저 공개 값 ──
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
NEXT_PUBLIC_SITE_NAME=운명다방
# 공유 링크 미리보기 이미지·알림톡 링크에 쓰는 사이트 주소. 비우면 Vercel 운영 도메인을 씁니다.
NEXT_PUBLIC_SITE_URL=

# 사이트 하단·약관에 표시되는 사업자 정보 (비워 두면 '등록 예정')
NEXT_PUBLIC_BIZ_NAME=
NEXT_PUBLIC_BIZ_CEO=
NEXT_PUBLIC_BIZ_REG_NO=
NEXT_PUBLIC_BIZ_MAIL_ORDER_NO=
NEXT_PUBLIC_BIZ_ADDRESS=
NEXT_PUBLIC_BIZ_PHONE=
NEXT_PUBLIC_BIZ_EMAIL=
NEXT_PUBLIC_BIZ_PRIVACY_OFFICER=
